<!doctype html><html lang="pt"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>busca-planes - Raúl Baeza Osuna</title><meta name="description" content="Sistema de agentes para recomendar atividades gratuitas, com um pesquisador web testado localmente e seleção demonstrada com 715 atividades em Madrid."><link rel="canonical" href="https://raulbaeza15.github.io/pt/busca-planes/caso/"><link rel="icon" href="/favicon.svg"><style>@import "https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600&display=swap";:root{--bg:#0a0b0d;--panel:#101216;--text:#f3f0e9;--muted:#9da0a6;--line:#282b31;--acid:#c7ff3d;--max:1220px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{background:var(--bg);color:var(--text);margin:0;font-family:Manrope,Arial,sans-serif;font-size:16px;line-height:1.6}a{color:inherit;text-decoration:none}a:focus-visible{outline:2px solid var(--acid);outline-offset:4px}.wrap{width:min(calc(100% - 48px),var(--max));margin-inline:auto}.nav{border-bottom:1px solid var(--line);justify-content:space-between;align-items:center;height:92px;display:flex}.mark{letter-spacing:-.06em;font-size:24px;font-weight:600}.mark span,.project-foot a,.cta span{color:var(--acid)}nav{text-transform:uppercase;letter-spacing:.08em;align-items:center;gap:34px;font-family:DM Mono,monospace;font-size:12px;display:flex}nav a:hover,footer a:hover{color:var(--acid)}.contact{border:1px solid var(--line);padding:10px 16px}.lang-switch{align-items:center;gap:6px;font-family:DM Mono,monospace;font-size:11px;letter-spacing:.08em;display:flex}.lang-switch a{color:var(--muted);padding:4px 2px}.lang-switch a[aria-current="page"]{color:var(--acid)}.lang-switch span{color:var(--line)}@media (max-width:560px){.lang-switch{gap:2px;font-size:10px;letter-spacing:.02em}.lang-switch a{padding:4px 1px}.nav .contact{white-space:nowrap}}.hero{min-height:690px;padding:95px 0 48px;position:relative;overflow:hidden}.kicker,.eyebrow,.section-head{text-transform:uppercase;letter-spacing:.1em;color:var(--muted);font-family:DM Mono,monospace;font-size:12px}.kicker span{background:var(--acid);width:7px;height:7px;box-shadow:0 0 15px var(--acid);border-radius:50%;margin-right:9px;display:inline-block}h1{letter-spacing:-.075em;z-index:1;margin:55px 0 58px;font-size:clamp(58px,8.8vw,128px);font-weight:500;line-height:.92;position:relative}h1 em{color:var(--muted);font-style:normal}.hero-bottom{z-index:1;grid-template-columns:1fr 1fr;align-items:end;display:grid;position:relative}.hero-bottom>p{color:#c3c4c7;max-width:570px;margin:0;font-size:19px}.actions{justify-content:flex-end;gap:10px;display:flex}.button{text-transform:uppercase;letter-spacing:.05em;border:1px solid var(--line);padding:15px 20px;font-family:DM Mono,monospace;font-size:12px}.button.primary{background:var(--acid);color:#111;border-color:var(--acid);font-weight:500}.signal{opacity:.55;align-items:center;gap:8px;display:flex;position:absolute;top:95px;right:4%;transform:rotate(-12deg)}.signal i{background:var(--acid);border-radius:4px;width:4px;display:block}.signal i:first-child,.signal i:nth-child(8){height:18px}.signal i:nth-child(2),.signal i:nth-child(7){height:35px}.signal i:nth-child(3),.signal i:nth-child(6){height:60px}.signal i:nth-child(4),.signal i:nth-child(5){height:90px}.section{padding:105px 0}.section-head{border-bottom:1px solid var(--line);justify-content:space-between;margin-bottom:0;display:flex}.project{border-bottom:1px solid var(--line);grid-template-columns:.92fr 1.08fr;gap:70px;min-height:530px;padding:72px 0;display:grid}.project-copy{flex-direction:column;display:flex}.eyebrow{color:var(--acid);margin:0 0 36px}.project h2{letter-spacing:-.055em;margin:0 0 10px;font-size:clamp(42px,5vw,70px);font-weight:500;line-height:1}.project h3{color:var(--muted);margin:0 0 34px;font-size:20px;font-weight:400}.description{color:#b9bbc0;max-width:580px;font-size:17px}.project ul{flex-wrap:wrap;gap:7px;margin:22px 0 36px;padding:0;list-style:none;display:flex}.project li,.stack span{border:1px solid var(--line);text-transform:uppercase;letter-spacing:.06em;padding:6px 10px;font-family:DM Mono,monospace;font-size:10px}.project-foot{border-top:1px solid var(--line);text-transform:uppercase;letter-spacing:.05em;justify-content:space-between;align-items:end;margin-top:auto;padding-top:18px;font-family:DM Mono,monospace;font-size:11px;display:flex}.project-foot strong{color:#d2d3d4;font-weight:400}.project-visual{background:#16191e;min-height:380px;display:flex;position:relative;overflow:hidden}.project-visual img{object-fit:cover;filter:saturate(.8);width:100%;height:100%;transition:all .4s}.project-visual:hover img{filter:saturate();transform:scale(1.02)}.nexus{background:radial-gradient(circle,#29351b 0,#111510 45%,#0d0f11 75%)}.nexus-art{text-align:center;color:#9fa88b;letter-spacing:.12em;grid-template:repeat(3,1fr)/repeat(3,1fr);align-items:center;width:100%;padding:45px;font-family:DM Mono,monospace;font-size:10px;display:grid}.nexus-art b{color:var(--acid);letter-spacing:-.06em;aspect-ratio:1;border:1px solid #63752e;border-radius:50%;grid-area:2/2;place-items:center;font-size:40px;display:grid;box-shadow:0 0 50px #aee93333}.about{grid-template-columns:1fr 1fr;gap:90px;display:grid}.about h2{letter-spacing:-.055em;margin:40px 0;font-size:clamp(40px,5vw,68px);font-weight:500;line-height:1.05}.about-copy{padding-top:45px}.about-copy p{color:#c4c5c8;margin:0 0 22px;font-size:19px}.stack{flex-wrap:wrap;gap:7px;margin-top:40px;display:flex}.cta{background:var(--acid);color:#0a0b0d;justify-content:space-between;align-items:flex-end;padding:75px;display:flex;margin-bottom:60px!important}.cta p{letter-spacing:-.055em;margin:0;font-size:clamp(40px,5vw,68px);line-height:1.05}.cta a{text-transform:uppercase;border-bottom:1px solid #0a0b0d;padding-bottom:4px;font-family:DM Mono,monospace}.cta span{color:#0a0b0d}footer{border-top:1px solid var(--line);color:var(--muted);text-transform:uppercase;justify-content:space-between;padding:28px 0 45px;font-family:DM Mono,monospace;font-size:11px;display:flex}footer div{gap:22px;display:flex}@media (width<=760px){.wrap{width:min(calc(100% - 28px),var(--max))}.nav{height:72px}.nav nav>a:not(.contact){display:none}.hero{min-height:auto;padding:66px 0 65px}.hero h1{margin:48px 0;font-size:54px}.hero-bottom{grid-template-columns:1fr;gap:35px}.actions{flex-wrap:wrap;justify-content:flex-start}.signal{top:40px;right:0;transform:scale(.7)rotate(-12deg)}.section{padding:72px 0}.project{grid-template-columns:1fr;gap:34px;min-height:auto;padding:55px 0}.project-visual{order:-1;min-height:280px}.project h2{font-size:43px}.eyebrow{margin-bottom:24px}.project-foot{align-items:flex-start;gap:20px;margin-top:28px}.about{grid-template-columns:1fr;gap:10px}.about-copy{padding-top:0}.cta{width:auto;padding:40px 25px;display:block;margin-inline:14px!important}.cta p{margin-bottom:45px;font-size:38px}footer{display:block}footer div{margin-top:15px}}@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}.email-link{overflow-wrap:anywhere;flex-direction:column;align-items:flex-start;max-width:100%;font-size:13px;display:flex}.email-link small{letter-spacing:.12em;opacity:.62;margin-bottom:4px;font-size:9px}.email-link span{margin-top:19px;margin-left:218px;position:absolute}@media (width<=760px){.email-link{display:inline-flex}.email-link span{margin:0 0 0 8px;position:static}}.hero-name{text-transform:uppercase;letter-spacing:.13em;color:var(--text);z-index:1;margin:38px 0 -35px;font-family:DM Mono,monospace;font-size:14px;position:relative}@media (width<=760px){.hero-name{margin:32px 0 -30px;font-size:12px}}.hero-name{letter-spacing:.08em;margin-top:36px;font-size:22px;font-weight:500}@media (width<=760px){.hero-name{letter-spacing:.07em;margin-top:30px;font-size:17px}}
.case{max-width:900px;margin:auto;padding:70px 24px}.case h1{font-size:clamp(40px,7vw,80px);margin:40px 0}.case p{font-size:21px;line-height:1.7}.case .actions{justify-content:flex-start;flex-wrap:wrap;margin-top:40px}</style></head><body><main class="case"><a href="/pt/">RB.</a><nav style="margin-top:25px;flex-wrap:wrap"><a href="/es/busca-planes/caso/">ES</a> / <a href="/busca-planes/caso/">EN</a> / <a href="/pt/busca-planes/caso/">PT</a> / <a href="/de/busca-planes/caso/">DE</a> / <a href="/fr/busca-planes/caso/">FR</a> / <a href="/nl/busca-planes/caso/">NL</a></nav><h1>busca-planes</h1><p>Sistema de agentes para recomendar atividades gratuitas, com um pesquisador web testado localmente e seleção demonstrada com 715 atividades em Madrid.</p><div class="actions"><a class="button" href="/busca-planes/demo.html">Ver demonstração</a><a class="button" href="https://github.com/RaulBaeza15/RaulBaeza15.github.io/tree/main/busca-planes">Ver código</a></div><p style="font-size:15px;margin-top:60px"><a href="/pt/">Voltar ao portefólio →</a></p></main></body></html>
